<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>WinForge</AssemblyName>
    <Version>1.0.0</Version>
    <RootNamespace>WinForge.App</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinForge.Modules.DynamicIsland\WinForge.Modules.DynamicIsland.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\WinForge.Modules.Capture\WinForge.Modules.Capture.csproj" />
    <ProjectReference Include="..\WinForge.Core\WinForge.Core.csproj" />
    <ProjectReference Include="..\WinForge.Modules.FileTools\WinForge.Modules.FileTools.csproj" />
    <ProjectReference Include="..\WinForge.Modules.Taskbar\WinForge.Modules.Taskbar.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\WinForge.Modules.AlwaysOnTop\WinForge.Modules.AlwaysOnTop.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\WinForge.Modules.TextGrabber\WinForge.Modules.TextGrabber.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\WinForge.Modules.NetSpeed\WinForge.Modules.NetSpeed.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\WinForge.Modules.Tiling\WinForge.Modules.Tiling.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\WinForge.Modules.Launcher\WinForge.Modules.Launcher.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\WinForge.Modules.Extras\WinForge.Modules.Extras.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\WinForge.Modules.WindowControl\WinForge.Modules.WindowControl.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="BuildReactUi" BeforeTargets="PrepareForBuild"
          Inputs="$(MSBuildProjectDirectory)\ui\package.json;$(MSBuildProjectDirectory)\ui\package-lock.json;$(MSBuildProjectDirectory)\ui\index.html;$(MSBuildProjectDirectory)\ui\vite.config.ts;$(MSBuildProjectDirectory)\ui\tsconfig*.json;$(MSBuildProjectDirectory)\ui\src\**\*"
          Outputs="$(MSBuildProjectDirectory)\wwwroot\index.html">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-ui.ps1&quot; -UiDirectory &quot;$(MSBuildProjectDirectory)\ui&quot;" />
  </Target>

  <Target Name="CopyReactUi" AfterTargets="Build">
    <ItemGroup>
      <ReactUiFiles Include="$(MSBuildProjectDirectory)\wwwroot\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ReactUiFiles)"
          DestinationFiles="@(ReactUiFiles->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="IncludeReactUiInPublish" AfterTargets="ComputeFilesToPublish" DependsOnTargets="BuildReactUi">
    <ItemGroup>
      <ReactUiFiles Include="$(MSBuildProjectDirectory)\wwwroot\**\*" />
      <ResolvedFileToPublish Include="@(ReactUiFiles)">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="BuildNativeShell" BeforeTargets="CopyModules" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-native.ps1&quot; -Configuration &quot;$(Configuration)&quot;" />
    <ItemGroup>
      <NativeShellFiles Include="$(MSBuildProjectDirectory)\..\..\native\WinForge.Shell\bin\x64\$(Configuration)\WinForge.ShellHost.exe;$(MSBuildProjectDirectory)\..\..\native\WinForge.Shell\bin\x64\$(Configuration)\WinForge.ShellTap.dll" />
      <NativeShellFiles Include="$(MSBuildProjectDirectory)\..\..\native\WinForge.Shell\bin\x64\$(Configuration)\WinForge.ExplorerNavigationTap.dll;$(MSBuildProjectDirectory)\..\..\native\WinForge.Shell\bin\x64\$(Configuration)\WinForge.FolderDialogTap.dll" />
      <NativeShellFiles Include="$(MSBuildProjectDirectory)\..\..\native\WinForge.Shell\bin\x64\$(Configuration)\WinForge.FolderSizeHost.exe;$(MSBuildProjectDirectory)\..\..\native\WinForge.Shell\bin\x64\$(Configuration)\WinForge.FolderSizeTap.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeShellFiles)" DestinationFolder="$(OutDir)native" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyModules" AfterTargets="Build">
    <ItemGroup>
      <ModuleProjects Include="@(ProjectReference)" Condition="'%(ProjectReference.ReferenceOutputAssembly)' == 'false'" />
      <ModuleProjects Include="..\WinForge.Modules.FileTools\WinForge.Modules.FileTools.csproj" />
      <ModuleProjects Include="..\WinForge.Modules.Capture\WinForge.Modules.Capture.csproj" />
      <RetiredFiles Include="$(OutDir)modules\WinForge.Modules.AltSnap.dll;$(OutDir)NAudio*.dll;$(OutDir)System.Management.dll;$(OutDir)System.CodeDom.dll" />
    </ItemGroup>
    <MSBuild Projects="@(ModuleProjects)" Targets="GetTargetPath" BuildInParallel="true" Properties="Configuration=$(Configuration);Platform=$(Platform)" RemoveProperties="RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="ModuleFiles" />
    </MSBuild>
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\WinForge.Modules.Extras\WinForge.Modules.Extras.csproj" Targets="GetModuleRuntimeFiles" Properties="Configuration=$(Configuration);Platform=$(Platform)" RemoveProperties="RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="ModuleFiles" />
    </MSBuild>
    <Delete Files="@(RetiredFiles)" />
    <Copy SourceFiles="@(ModuleFiles)" DestinationFolder="$(OutDir)modules" SkipUnchangedFiles="true" />
    <ItemGroup>
      <DictationFiles Include="$(MSBuildProjectDirectory)\..\WinForge.Dictation.Worker\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DictationFiles)" DestinationFiles="@(DictationFiles->'$(OutDir)dictation\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="IncludeModulesInPublish" AfterTargets="ComputeFilesToPublish" DependsOnTargets="CopyModules">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(ModuleFiles)">
        <RelativePath>modules/%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(NativeShellFiles)">
        <RelativePath>native/%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="@(DictationFiles)">
        <RelativePath>dictation/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="GetModuleFiles" DependsOnTargets="CopyModules" Returns="@(ModuleFiles)" />

  <Target Name="PrepareDictationEngine" BeforeTargets="CopyModules" Condition="'$(DesignTimeBuild)' != 'true'" Inputs="$(MSBuildProjectDirectory)\..\..\native\WinForge.Whisper\WhisperBridge.cpp;$(MSBuildProjectDirectory)\..\..\native\WinForge.Whisper\CMakeLists.txt;$(MSBuildProjectDirectory)\..\..\scripts\build-dictation.ps1" Outputs="$(MSBuildProjectDirectory)\..\WinForge.Dictation.Worker\bin\$(Configuration)\net10.0\cpu\WinForge.Whisper.dll">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\build-dictation.ps1&quot; -Configuration &quot;$(Configuration)&quot;" />
  </Target>

</Project>
