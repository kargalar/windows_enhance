<Window x:Class="WinForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="WinForge" Icon="Assets/WinForge.ico" Width="1280" Height="860" MinWidth="980" MinHeight="680"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True" UseLayoutRounding="True" PreviewKeyDown="OnWindowKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="surface" Background="{TemplateBinding Background}" CornerRadius="10" Margin="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="surface" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Close" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="surface" Property="Background" Value="{DynamicResource DangerBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="surface" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource BgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="15,0" VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="W" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BgBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="WinForge" FontSize="12" LineHeight="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" />
                        <TextBlock x:Name="TitleBarSubtitle" Text="CONTROL CENTER" FontSize="8"
                                   Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button x:Name="MinimizeButton" Style="{StaticResource WindowControlButton}" Content="&#xE921;" ToolTip="Minimize"
                            AutomationProperties.Name="Minimize" Click="OnMinimizeClick" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}" Content="&#xE922;" ToolTip="Maximize"
                            AutomationProperties.Name="Maximize" Click="OnMaximizeClick" />
                    <Border Width="1" Height="18" Margin="5,0" Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center" />
                    <Button x:Name="CloseButton" Style="{StaticResource WindowControlButton}" Tag="Close" Content="&#xE8BB;" ToolTip="Close"
                            AutomationProperties.Name="Close" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>
        <wv2:WebView2 Grid.Row="1" x:Name="UiWebView" DefaultBackgroundColor="#FFFFFF" />
    </Grid>
</Window>
