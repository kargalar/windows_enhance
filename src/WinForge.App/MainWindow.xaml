<Window x:Class="WinForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="WinForge" Width="1280" Height="860" MinWidth="980" MinHeight="680"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True" UseLayoutRounding="True" PreviewKeyDown="OnWindowKeyDown">
    <Grid Background="{DynamicResource BgBrush}">
        <wv2:WebView2 x:Name="UiWebView" DefaultBackgroundColor="#101010" />
    </Grid>
</Window>
