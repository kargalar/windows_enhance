<Window x:Class="WinForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinForge"
        Width="1180" Height="780"
        MinWidth="1060" MinHeight="660"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,22,16,16">

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,28">
                    <Border Width="40" Height="40" CornerRadius="11" Background="{DynamicResource AccentGradient}">
                        <TextBlock Text="W" FontSize="21" FontWeight="Bold" Foreground="#06111A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WinForge" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Windows customization" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button Style="{StaticResource GhostButton}" Click="OnAppearanceClick" Margin="0,0,0,10" AutomationProperties.Name="Görünüm">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Görünüm" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="9" Padding="12,10" Margin="0,0,0,10"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="MOTOR" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                                           Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="EngineStatus" Text="Hazır" FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Button Content="Logları aç" Style="{StaticResource GhostButton}" Click="OnOpenLogs" />
                    <Button Content="Çıkış" Style="{StaticResource GhostButton}" Click="OnExit" Margin="0,3,0,0" />
                    <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="10.5"
                               Foreground="{DynamicResource MutedBrush}" Margin="11,14,0,2" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="KATEGORİLER" FontSize="9.5" Foreground="{DynamicResource MutedBrush}"
                               Margin="11,0,0,8" />
                    <ListBox x:Name="CategoryList"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavItem}"
                             SelectionChanged="OnCategoryChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="12.5"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Ellipse x:Name="GlowLayer" Width="760" Height="760" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-360,-220,0" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#244CC2FF" Offset="0" />
                        <GradientStop Color="#004CC2FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Grid Margin="30,26,30,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock x:Name="PageTitle" Text="Tüm modüller" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock x:Name="PageSubtitle" Text="Windows'unu kendi akışına göre şekillendir."
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12.5" Margin="0,6,0,0" />
                    </StackPanel>

                    <Border Width="260" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Grid>
                            <Border Width="260" Height="38" CornerRadius="9" Background="{DynamicResource InputBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{DynamicResource MutedBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                            <TextBox x:Name="SearchBox" Height="38" Background="Transparent" Padding="34,8,10,8"
                                     BorderThickness="0" TextChanged="OnSearchChanged" />
                            <TextBlock x:Name="SearchHint" Text="Modül ara"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                       VerticalAlignment="Center" Margin="35,0,0,0" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="310" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="352" />
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="ModuleList"
                             Grid.Column="0"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource ModuleItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnModuleSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="card" CornerRadius="12"
                                        Padding="16" Margin="0,0,0,10" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Background" Value="{DynamicResource SelectedCardBrush}" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="42" Height="42" CornerRadius="10"
                                                Background="{DynamicResource AccentSoftBrush}"
                                                BorderBrush="{DynamicResource IconBorderBrush}" BorderThickness="1"
                                                Margin="0,0,14,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}"
                                                       FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Text="{Binding ShortDescription}" FontSize="11.5"
                                                       Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <CheckBox Style="{StaticResource SwitchStyle}"
                                                      IsChecked="{Binding IsActive, Mode=OneWay}"
                                                      Click="OnModuleToggle"
                                                      Tag="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Column="2" Background="{DynamicResource CardBrush}" CornerRadius="14"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel x:Name="DetailPanel" Margin="20,18,14,18" />
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="2,12,0,0">
                    <TextBlock x:Name="StatusBar" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                    <TextBlock Text="Alt+F sabitle · Alt+Q OCR" Foreground="{DynamicResource MutedBrush}"
                               FontSize="10.5" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.8" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
