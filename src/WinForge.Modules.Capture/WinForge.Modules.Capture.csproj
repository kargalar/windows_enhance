<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="WinForge.CaptureTests" />
    <Content Include="../../third_party/Whisper/*" Link="licenses/Whisper/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../WinForge.Dictation.Worker/WinForge.Dictation.Worker.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="../WinForge.Dictation.Worker/Protocol.cs" Link="Dictation/Protocol.cs" />
    <Using Include="System.IO" />
    <ProjectReference Include="../WinForge.Core/WinForge.Core.csproj" Private="false" />
    <ProjectReference Include="../WinForge.History/WinForge.History.csproj" />
    <ProjectReference Include="../WinForge.Modules.FileTools/WinForge.Modules.FileTools.csproj" />
  </ItemGroup>
</Project>
