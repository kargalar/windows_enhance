<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <ProjectReference Include="../../src/WinForge.Modules.FileTools/WinForge.Modules.FileTools.csproj" />
    <Content Include="Fixtures/text-identity.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/Recordings/*" CopyToOutputDirectory="PreserveNewest" />
    <Page Include="../../src/WinForge.App/Theme.xaml" Link="TestTheme.xaml" />
  </ItemGroup>
</Project>
