<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/WinForge.App/WinForge.App.csproj" />
    <ProjectReference Include="../../src/WinForge.Modules.WindowControl/WinForge.Modules.WindowControl.csproj" />
  </ItemGroup>
  <Target Name="CopyTestModules" AfterTargets="Build">
    <MSBuild Projects="../../src/WinForge.App/WinForge.App.csproj" Targets="GetModuleFiles" Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="TestModules" />
    </MSBuild>
    <ItemGroup>
      <RetiredTestFiles Include="$(OutDir)modules\WinForge.Modules.AltSnap.dll;$(OutDir)NAudio*.dll;$(OutDir)System.Management.dll;$(OutDir)System.CodeDom.dll" />
      <NativeShellTestFiles Include="$(MSBuildProjectDirectory)\..\..\native\WinForge.Shell\bin\x64\$(Configuration)\WinForge.ShellHost.exe;$(MSBuildProjectDirectory)\..\..\native\WinForge.Shell\bin\x64\$(Configuration)\WinForge.ShellTap.dll;$(MSBuildProjectDirectory)\..\..\native\WinForge.Shell\bin\x64\$(Configuration)\WinForge.ShellFixture.exe" />
      <NativeShellTestFiles Include="$(MSBuildProjectDirectory)\..\..\native\WinForge.Shell\bin\x64\$(Configuration)\WinForge.ContextMenuTap.dll" />
      <ReactTestFiles Include="$(MSBuildProjectDirectory)\..\..\src\WinForge.App\wwwroot\**\*" />
    </ItemGroup>
    <Delete Files="@(RetiredTestFiles)" />
    <Copy SourceFiles="@(TestModules)" DestinationFolder="$(OutDir)modules" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NativeShellTestFiles)" DestinationFolder="$(OutDir)native" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ReactTestFiles)" DestinationFiles="@(ReactTestFiles->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
