<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/WinForge.Core/WinForge.Core.csproj" />
    <Compile Include="../../src/WinForge.Modules.Extras/KnownFolderPaths.cs" Link="KnownFolderPaths.cs" />
    <Compile Include="../../src/WinForge.Modules.Extras/FileAssociationService.cs" Link="FileAssociationService.cs" />
    <Compile Include="../../src/WinForge.Modules.Extras/DefaultSettingsModule.cs" Link="DefaultSettingsModule.cs" />
    <Compile Include="../../src/WinForge.Modules.Extras/DefaultPathsModule.cs" Link="DefaultPathsModule.cs" />
    <Compile Include="../../src/WinForge.Modules.Extras/DefaultAppsModule.cs" Link="DefaultAppsModule.cs" />
  </ItemGroup>
</Project>
