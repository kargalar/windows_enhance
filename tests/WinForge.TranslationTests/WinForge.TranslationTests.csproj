    <Compile Include="../../src/WinForge.Modules.Extras/AutomationCommands.cs" Link="AutomationCommands.cs" />
    <Compile Include="../../src/WinForge.Modules.Extras/KeyboardInputSender.cs" Link="KeyboardInputSender.cs" />
    <Compile Include="../../src/WinForge.Modules.Extras/SelectionTranslationService.cs" Link="SelectionTranslationService.cs" />
    <Compile Include="../../src/WinForge.Modules.Extras/SelectionTranslationLanguage.cs" Link="SelectionTranslationLanguage.cs" />
    <Compile Include="../../src/WinForge.Modules.Extras/ChromiumClipboardData.cs" Link="ChromiumClipboardData.cs" />
