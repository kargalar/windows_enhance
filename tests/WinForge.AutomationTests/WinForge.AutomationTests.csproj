    <Compile Include="../../src/WinForge.Modules.Extras/AutomationRule.cs" Link="AutomationRule.cs" />
    <Compile Include="../../src/WinForge.Modules.Extras/ForegroundShortcutBinding.cs" Link="ForegroundShortcutBinding.cs" />
    <Compile Include="../../src/WinForge.Modules.Extras/SelectionSearch.cs" Link="SelectionSearch.cs" />
    <Compile Include="../../src/WinForge.Modules.Extras/KeyboardInputSender.cs" Link="KeyboardInputSender.cs" />
  </ItemGroup>
